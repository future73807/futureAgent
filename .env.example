# ===== 模型配置 =====
# 必须填成"本部署实际可调用"的模型。内置模型不再包含 GPT 系列：自建/中转
# 端点上它们基本已下线，调用会直接 404，而配了 OPENAI_API_KEY 又会让界面把
# 它显示成就绪，是最容易误选的一类。接入自建网关或中转站的模型请加进
# EXTRA_MODEL_IDS_CSV，并让 DEFAULT_MODEL 指向其中一个。
DEFAULT_MODEL=glm-5.3-flash
# 未使用的供应商凭据必须保持空值。请只填写供应商实际签发的密钥，不要
# 保留示例文字或把密钥加引号；OpenAI 兼容服务通常使用 sk-... 形式。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 额外的 OpenAI 兼容模型 id（逗号分隔），经 OPENAI_BASE_URL / OPENAI_API_KEY 路由。
# 例：EXTRA_MODEL_IDS_CSV=glm-5.3-flash,glm-5.3
EXTRA_MODEL_IDS_CSV=
# 单模型档案（JSON 数组）。给某个模型单独指定端点，并声明能力；能力字段会
# 显示在设置面板的"模型"分区里，未登记档案的模型不会谎报视觉与上下文长度。
# 例：
# MODEL_PROFILES_JSON=[{"id":"glm-5.3-flash","name":"glm-5.3-flash","url":"https://your-relay.example/v1","toolCalling":true,"vision":true,"maxInputTokens":1000000,"maxOutputTokens":128000}]
MODEL_PROFILES_JSON=
# Anthropic 密钥通常以 sk-ant-... 开头。
ANTHROPIC_API_KEY=
# 填写 Google AI Studio / Vertex AI 实际签发的 API Key。
GOOGLE_API_KEY=
# Docker Compose 默认通过宿主机别名访问本机 Ollama；本机直接运行 API 时改为
# http://localhost:11434。该值可显式覆盖 Compose 的默认地址。
OLLAMA_BASE_URL=http://host.docker.internal:11434
LONGCAT_API_KEY=
LONGCAT_API_BASE=https://api.longcat.chat/openai

# 可选 LiteLLM 内部网关。URL 留空时按上面的供应商凭据直连；启用代理时
# URL 与 Master Key 必须同时填写，且 Master Key 不得提交到版本库。
LITELLM_PROXY_URL=
LITELLM_MASTER_KEY=

# ===== 应用身份与数据 =====
# 本地开发默认使用 sqlite；生产/Docker 请设置 PostgreSQL URL
DATABASE_URL=sqlite:///./futureagent.db
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=14
BOOTSTRAP_ADMIN_EMAIL=admin@futureagent.dev
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
# 工作区文件根：API 只读它来取 AGENTS.md / CLAUDE.md（设置面板"规则与记忆"里的
# 导入开关）。默认指向本机 MCP 服务的 workspace 目录；Compose 部署下 API 以只读
# 方式挂载同一个卷。读不到就是没有约定文件，不报错也不阻塞执行。
WORKSPACE_FILES_ROOT=./mcp_server/workspace
# 单次受控 AI 执行的最大时长，以及每个工作区的运行并发上限。
# API 会在服务端强制执行这两个限制，即使浏览器已退出也不会失效。
AGENT_RUN_TIMEOUT_SECONDS=180
MAX_CONCURRENT_AGENT_RUNS_PER_WORKSPACE=2

# ===== 运行模式与权限档位 =====
# 权限档位的部署上限：default / auto_approve / full_access。
# 设为 default 可全局禁用自动批准与完全访问；非法取值按最严格处理。
# 档位只放宽人工审批环节：RBAC、租户目录隔离与 run_python 禁用不受影响。
MAX_PERMISSION_MODE=full_access
# 五档运行模式 chat/plan/agent/goal/loop；goal/loop 靠监督节点判定是否再迭代。
# 下面是单次请求的最大轮次与 LangGraph 递归上限（监督模式会随轮次放宽，
# 但另有 200 的硬顶）。
AGENT_MAX_ITERATIONS=5
AGENT_RECURSION_LIMIT=25
# 子代理嵌套层数上限：0 完全禁用，1 只允许派生一层，2 允许父→子→孙。
# 子代理还需技能白名单显式列出 dispatch_subagent，且角色拥有对应 RBAC 权限。
SUBAGENT_MAX_DEPTH=2
SUBAGENT_MAX_PARALLEL=2
# 登录/注册/刷新接口每 IP 每分钟最大尝试次数；0 关闭限流。
# 多副本部署建议在网关（nginx limit_req）做等效限制。
AUTH_RATE_LIMIT_PER_MINUTE=60

# ===== 知识库向量召回（可选） =====
# off=纯关键词召回；ollama=本地模型（推荐 Qwen 系列 embedding）；openai=OpenAI 兼容服务。
# Ollama 方式：先 `ollama pull qwen3-embedding`，再设置 EMBEDDING_PROVIDER=ollama。
# 未启用或向量服务不可用时，知识检索自动退回关键词召回，不影响其它功能。
EMBEDDING_PROVIDER=off
EMBEDDING_MODEL=qwen3-embedding
# 向量维度：决定 pgvector 列维度与 HNSW 索引；更换模型后需同步调整
EMBEDDING_DIM=1024
# HNSW 调参（仅 Postgres 生效）：20k 块规模实测 ef_search=40 即 100% 召回@10
# 且比精确扫描快约 2 倍；百万级建议 m=32/ef_c=128/ef_s=64 并用
# scripts/benchmark_hnsw.py 实测校准
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=40
# local 适合开发环境；使用 MinIO/S3 时设为 s3 并填写下方字段。
STORAGE_BACKEND=local
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PREFIX=futureagent
RUN_MIGRATIONS_ON_STARTUP=false
METRICS_BEARER_TOKEN=
CORS_ORIGINS_CSV=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:8082

# ===== MCP 配置 =====
MCP_SERVER_PORT=8050
MCP_HOSTNAMES_CSV=localhost
# 可选：使用稳定名称配置多个服务（设置后优先于 MCP_HOSTNAMES_CSV）
# MCP_SERVERS_JSON={"local_tools":"http://localhost:8050/mcp"}
MCP_CONNECT_TIMEOUT=5
# Docker 内置 MCP 会校验 API 签发的工作区声明，并把文件根目录按租户隔离；
# 非内置或无法验证该声明的 MCP 服务请保持 false。
ENABLE_LOCAL_MCP_TOOLS=true
# 可以接收工作区签名声明的服务名（逗号分隔）。声明等于该租户的文件根，
# 只登记你信任的本地服务；默认仅内置的 local_tools。
MCP_WORKSPACE_SCOPED_SERVERS_CSV=local_tools
# 生产环境必须替换；API 与 MCP 容器必须使用完全相同的值。
MCP_WORKSPACE_SIGNING_KEY=replace-with-a-long-random-mcp-workspace-secret
# 仅应在隔离的 MCP 容器中启用任意 Python 执行。
MCP_ENABLE_PYTHON_TOOL=false
MCP_ALLOWED_HOSTS_CSV=localhost:8050,127.0.0.1:8050,[::1]:8050
MCP_WEB_TIMEOUT_SECONDS=15
MCP_WEB_MAX_BYTES=500000
# Clash/TUN 的 fake-IP DNS 常使用 198.18.0.0/15。该网段默认拒绝；
# 只有确认本机由可信 TUN 代理接管时才显式设为 true。
MCP_WEB_ALLOW_DNS_FAKE_IPS=false
# 差异分析的版本快照保留策略（MCP 服务读取）：每个文件保留最近 N 个
# 可回溯版本，整个工作区的快照总量超出预算时从最旧开始释放内容
# （变更记录本身保留，仅标记为无副本）。
MCP_FILE_VERSION_RETENTION=20
MCP_FILE_VERSION_MAX_BYTES=52428800

# ===== 数据库配置 =====
POSTGRES_DSN=postgresql://postgres:password@localhost:25432/postgres

# ===== Langfuse 可观测性 =====
# 启用时同时填写项目的 Public Key（通常 pk-...）和 Secret Key（通常 sk-...）。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== 应用配置 =====
ENVIRONMENT=development
# Docker 对外端口；本机有冲突时只需改这里，无需修改 Compose 文件。
USER_FRONTEND_PORT=8081
ADMIN_FRONTEND_PORT=8082
GATEWAY_PORT=80
# 管理端“用户端”按钮默认跳转 GATEWAY_PORT；跨域部署时填写完整公网地址。
USER_FRONTEND_PUBLIC_URL=
