# ===== 模型配置 =====
DEFAULT_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=sk-your-anthropic-key
GOOGLE_API_KEY=your-google-api-key
OLLAMA_BASE_URL=http://localhost:11434

# ===== LiteLLM Proxy =====
# 本地直接运行 API 时可填写 http://localhost:4000；留空则由 API 直连模型提供商
LITELLM_PROXY_URL=
LITELLM_MASTER_KEY=sk-futureagent
LITELLM_SALT_KEY=futureagent-salt-change-me

# ===== 应用身份与数据 =====
# 本地开发默认使用 sqlite；生产/Docker 请设置 PostgreSQL URL
DATABASE_URL=sqlite:///./futureagent.db
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=14
BOOTSTRAP_ADMIN_EMAIL=admin@futureagent.dev
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
# local is suitable for development; set s3 with the fields below for MinIO/S3.
STORAGE_BACKEND=local
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PREFIX=futureagent
RUN_MIGRATIONS_ON_STARTUP=false
METRICS_BEARER_TOKEN=
CORS_ORIGINS_CSV=http://localhost:5173,http://localhost:5174

# ===== MCP 配置 =====
MCP_SERVER_PORT=8050
MCP_HOSTNAMES_CSV=localhost
# 可选：使用稳定名称配置多个服务（设置后优先于 MCP_HOSTNAMES_CSV）
# MCP_SERVERS_JSON={"local_tools":"http://localhost:8050/mcp"}
MCP_CONNECT_TIMEOUT=5
# Local filesystem tools are disabled by default in multi-workspace deployments.
# Enable only for an isolated single-workspace MCP deployment.
ENABLE_LOCAL_MCP_TOOLS=false

# ===== 数据库配置 =====
POSTGRES_DSN=postgresql://postgres:password@localhost:5432/postgres

# ===== Langfuse 可观测性 =====
LANGFUSE_PUBLIC_KEY=pk-your-langfuse-key
LANGFUSE_SECRET_KEY=sk-your-langfuse-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== 应用配置 =====
ENVIRONMENT=development
